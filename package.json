{
  "name": "hotzone-digital-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nexteer Plant 78 Hot Zone CV joint line - virtual training simulator (educational, not validated)",
  "scripts": {
    "dev": "vite",
    "docs:generate": "node scripts/generate-docs.mjs",
    "validate:evidence": "node scripts/validate-evidence.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate:evidence && tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "render:compare": "npm run build && node scripts/render-compare.mjs",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
